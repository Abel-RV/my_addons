<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_multas_template">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="row mb-4 border-bottom pb-2">
                            <div class="col-12">
                                <h2 class="text-primary">
                                    <i class="fa fa-car me-2"/> Informe de Gestión de Multas
                                </h2>
                                <p class="text-muted small">
                                    Fecha de emisión: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                                </p>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-6">
                                <div class="card bg-light">
                                    <div class="card-body p-3 text-center">
                                        <h5 class="card-title text-muted mb-0">Total Multas</h5>
                                        <h3 class="font-weight-bold text-dark mb-0">
                                            <span t-esc="len(docs)"/>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="card bg-light">
                                    <div class="card-body p-3 text-center">
                                        <h5 class="card-title text-muted mb-0">Importe Total</h5>
                                        <h3 class="font-weight-bold text-dark mb-0">
                                            <span t-esc="sum(docs.mapped('importe'))" 
                                                  t-options='{"widget": "monetary", "display_currency": user.company_id.currency_id}'/>
                                        </h3>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <table class="table table-striped table-hover mt-3">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 15%;">Fecha</th>
                                    <th style="width: 25%;">Empleado</th>
                                    <th style="width: 20%;">Tipo Sanción</th>
                                    <th style="width: 20%;">Estado</th>
                                    <th style="width: 20%;" class="text-end">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="docs" t-as="multa">
                                    <tr>
                                        <td><span t-field="multa.fecha"/></td>
                                        <td>
                                            <strong><span t-field="multa.empleado_id.name"/></strong>
                                            <div class="text-muted small"><span t-field="multa.descripcion"/></div>
                                        </td>
                                        <td><span t-field="multa.tipo_multa_id.name"/></td> <td>
                                            <t t-if="multa.pagada">
                                                <span class="badge rounded-pill bg-success p-2 text-white">Pagada</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge rounded-pill bg-danger p-2 text-white">Pendiente</span>
                                            </t>
                                        </td>
                                        <td class="text-end font-weight-bold">
                                            <span t-field="multa.importe" 
                                                  t-options='{"widget": "monetary", "display_currency": user.company_id.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row mt-3">
                            <div class="col-7"></div>
                            <div class="col-5">
                                <table class="table table-sm table-borderless">
                                    <tr class="border-top">
                                        <td class="text-end"><strong>Total a Pagar:</strong></td>
                                        <td class="text-end">
                                            <span t-esc="sum(docs.mapped('importe'))" 
                                                  t-options='{"widget": "monetary", "display_currency": user.company_id.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
    </data>
</odoo>